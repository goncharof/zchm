{
  "name": "zchm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Заклятье Чёрного мага — браузерная версия настольной ролевой игры 1997 года",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "data:bestiary": "tools/.venv/bin/python -I tools/build_bestiary.py",
    "data:book": "tools/.venv/bin/python -I tools/build_book_of_life.py",
    "data:world": "tools/.venv/bin/python -I tools/build_world.py",
    "data:rules": "tools/.venv/bin/python -I tools/build_rules.py",
    "data:lore": "tools/.venv/bin/python -I tools/build_lore.py",
    "data:text": "tools/.venv/bin/python -I tools/extract_text.py source/pdf source/text",
    "server": "tsx watch server/index.ts",
    "build:server": "vite build --ssr server/index.ts --outDir server-dist --emptyOutDir",
    "start": "node server-dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "pinia": "^4.1.0",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
