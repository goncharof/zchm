 "13": {
  "id": "a",
  "on": "enter",
  "text": [
   {
    "t": "У самого берега стоит драконид, он показывает вам непристойные жесты и кричит: “Эй вы, идиоты в лодке, гребите сюда — убью”."
   }
  ],
  "npcs": [
   "drakonid"
  ],
  "then": [
   {
    "id": "b",
    "on": "choice",
    "label": "Подплываете",
    "text": [
     {
      "t": "пытается убежать, но, поскользнувшись, падает. Кричит, что, если вы его не убьете, он покажет вам место клада."
     }
    ],
    "exclusive": true,
    "then": [
     {
      "id": "c",
      "on": "choice",
      "label": "Если вы соглашаетесь",
      "text": [
       {
        "t": "ведет вас в лес."
       }
      ],
      "dice": {
       "sides": 6
      },
      "then": [
       {
        "id": "c1",
        "on": {
         "roll": [
          1,
          2,
          3
         ]
        },
        "text": [
         {
          "t": "свистит. На свист прибегают 4 драконида и нападают."
         }
        ],
        "hints": {
         "monsters": [
          "drakonid"
         ],
         "monsterCounts": {
          "drakonid": 4
         }
        }
       },
       {
        "id": "c2",
        "on": {
         "roll": [
          4,
          5,
          6
         ]
        },
        "text": [
         {
          "t": "вынимает из дупла дерева ларец. В нем 80 монет и (5)."
         }
        ],
        "hints": {
         "coins": [
          80
         ],
         "bottles": [
          5
         ]
        }
       }
      ]
     },
     {
      "id": "d",
